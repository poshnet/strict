// strict.fun: one Worker serves the app (web/dist, built by Vite) and the API (worker/), and runs the minute cron:
// the index of the strict program, then the cranks (migrate, buyback, creator payouts).
// Secrets (never here): RPC_URL (Helius), VAULT_KEY (encrypts mint keys), OPS_SECRET (the crank), ADMIN_KEY.
// Local dev reads .dev.vars (the local validator); see README, "Run it locally".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strict",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // pages go through the worker (so /coin/<mint> and /kol/<id> unfurl as what they point at); so do the built files
    // and KOL pictures while COMING_SOON is on, so the gate (worker/soon.js) can withhold them. After launch, add
    // "!/assets/*" and "!/kols/*" back to serve them straight from the assets.
    "run_worker_first": ["/*", "!/assets/hero/*", "!/favicon.svg", "!/og.jpg", "!/icon-512.png", "!/apple-touch-icon.png"]
  },
  // D1 "strict" (created 2026-10-31)
  "d1_databases": [
    { "binding": "DB", "database_name": "strict", "database_id": "4926f2da-3272-48b6-b40c-44ae8123b0fb", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "strict-media" }],
  "triggers": { "crons": ["* * * * *"] },
  "limits": { "cpu_ms": 30000 },
  "workers_dev": true,
  // strict.fun: the zone went active on Cloudflare 2026-10-31
  "routes": [{ "pattern": "strict.fun", "custom_domain": true }, { "pattern": "www.strict.fun", "custom_domain": true }],
  "vars": {
    "SITE_NAME": "strict.fun",
    "SITE_URL": "https://strict.fun",
    "X_HANDLE": "strictdotfun",
    // the program's fee_recipient (set when the program is initialized) and the crank's wallet
    "FEE_WALLET": "58HtzYFJXX4qMNYNZY5Xpbyo7S2aBZFjsAkpTiNgRGRS",
    "OPS_WALLET": "9ShCaYigEgKnhmHWePcxMAzUaDRjUEK8XLY73vf1FiYE",
    // "1" once the program is on mainnet and initialized and strict.fun serves this worker (every coin's metadata uri is
    // SITE_URL/m/<mint>.json, baked in for good at launch)
    "LAUNCHES": "0",
    // "1": every page is the coming-soon page and the API is closed, except with the preview link (worker/soon.js;
    // the PREVIEW_KEY secret is in keys/PREVIEW_KEY.txt)
    "COMING_SOON": "1",
    // the public repo the site's code panels link to (open-sourced 2026-11-02)
    "SOURCE_URL": "https://github.com/poshnet/strict",
    "CRANK": "1",
    "KOL_MIN_FOLLOWERS": "10000"
  },
  "observability": { "enabled": true }
}
